generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  phoneNumber      String        @unique
  fullName         String
  avatarUrl        String?
  passwordHash     String
  countryCode      String
  nationality      String?
  language         String?
  kycStatus        KycStatus     @default(PENDING)
  documentType     DocumentType?
  documentNumber   String?       @unique
  documentPhotoUrl String?
  dateOfBirth      DateTime?
  address          String?
  postalCode       String?
  city             String?
  state            String?
  isPhoneVerified  Boolean       @default(false)
  isEmailVerified  Boolean       @default(false)
  role             UserRole      @default(CUSTOMER)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  transactions     Transaction[]
  wallet           Wallet?

  @@index([email])
  @@index([phoneNumber])
  @@index([documentNumber])
}

model Wallet {
  id               String        @id @default(uuid())
  userId           String        @unique
  currency         String
  balance          Decimal       @default(0.00)
  frozen           Decimal       @default(0.00)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactionsFrom Transaction[] @relation("FromWallet")
  transactionsTo   Transaction[] @relation("ToWallet")
  user             User          @relation(fields: [userId], references: [id])

  @@unique([userId, currency])
  @@index([currency])
}

model Transaction {
  id                String            @id @default(uuid())
  fromWalletId      String
  toWalletId        String
  fromAmount        Decimal
  fromCurrency      String
  toAmount          Decimal
  toCurrency        String
  exchangeRate      Decimal?
  status            TransactionStatus @default(PENDING)
  type              TransactionType   @default(TRANSFER)
  note              String?
  createdAt         DateTime          @default(now())
  completedAt       DateTime?
  failedAt          DateTime?
  referenceCode     String?           @unique
  initiatedByUserId String?
  fromWallet        Wallet            @relation("FromWallet", fields: [fromWalletId], references: [id])
  initiatedByUser   User?             @relation(fields: [initiatedByUserId], references: [id])
  toWallet          Wallet            @relation("ToWallet", fields: [toWalletId], references: [id])

  @@index([fromWalletId])
  @@index([toWalletId])
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPPORT
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  REVIEW
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVER_LICENSE
  RESIDENCE_PERMIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  EXCHANGE
  REFUND
}
